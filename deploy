prompt_install() {
    echo -n "$1 is not installed. Would you like to install it? (y/n) " >&2
    old_stty_cfg=$(stty -g)
    stty raw -echo
    answer=$( while ! head -c 1 | grep -i '[ny]' ;do true ;done )
    stty $old_stty_cfg && echo
    if echo "$answer" | grep -iq "^y" ;then
        # Map command name -> distro package name where they differ
        # (e.g. the `nvim` binary is provided by the `neovim` package everywhere)
        pkg="$1"
        case "$1" in
            nvim) pkg="neovim" ;;   # provided by the neovim package on every manager
            node) pkg="nodejs" ;;   # apt/pacman name; brew/pkg override to "node" below
            wl-copy) pkg="wl-clipboard" ;;
        esac
        # This could def use community support
        if [ "$(uname)" = "Linux" ] && [ -x "$(command -v apt)" ]; then
            if [ "$1" = "nvim" ]; then
                # Install latest neovim from source
                sudo apt install -y build-essential cmake gettext libtool libtool-bin autoconf automake pkg-config unzip curl doxygen ninja-build
                cd /tmp
                rm -rf /tmp/neovim
                git clone --branch release-0.11 git@github.com:neovim/neovim.git
                cd neovim
                git checkout stable
                # Build with the default Ninja generator (ninja-build is installed
                # above). The old CMAKE_GENERATOR="Unix Makefiles" broke here:
                # neovim's Makefile re-expands it unquoted, so cmake received
                # "-G Unix" and failed with "Could not create named generator Unix".
                # Ninja is what actually built successfully. Installs to /usr/local.
                make CMAKE_BUILD_TYPE=RelWithDebInfo
                sudo make install
                cd ..
                sudo rm -rf neovim
            else
                sudo apt install $pkg -y
            fi

        elif [ "$(uname)" = "Darwin" ] && [ -x "$(command -v brew)" ]; then
            [ "$1" = "node" ] && pkg="node"   # Homebrew formula is 'node'
            # Determine machine's architecture
            arch_name="$(uname -m)"

            # If architecture is ARM, install from source
            if [ "${arch_name}" = "arm64" ]; then
                brew install --build-from-source $pkg
            else
                brew install $pkg
            fi

        elif [ "$(uname)" = "FreeBSD" ] && [ -x "$(command -v pkg)" ]; then
            [ "$1" = "node" ] && pkg="node"   # FreeBSD pkg is 'node'
            sudo pkg install $pkg

        elif [ "$(uname)" = "Linux" ] && [ -x "$(command -v pacman)" ]; then
            sudo pacman -S $pkg

        else
            echo "I'm not sure what your package manager is! Please install $1 on your own and run this deploy script again. Tests for package managers are in the deploy script you just ran starting at line 13. Feel free to make a pull request at https://github.com/parth/dotfiles :)"
        fi
    fi
}

check_for_software() {
	echo "Checking to see if $1 is installed"
	if ! [ -x "$(command -v $1)" ]; then
		prompt_install $1
	else
		echo "$1 is installed."
	fi
}

check_default_shell() {
	if [ -z "${SHELL##*zsh*}" ] ;then
			echo "Default shell is zsh."
	else
		echo -n "Default shell is not zsh. Do you want to chsh -s \$(which zsh)? (y/n)"
		old_stty_cfg=$(stty -g)
		stty raw -echo
		answer=$( while ! head -c 1 | grep -i '[ny]' ;do true ;done )
		stty $old_stty_cfg && echo
		if echo "$answer" | grep -iq "^y" ;then
			if chsh -s "$(which zsh)" ;then
				echo "Default shell changed to zsh (takes effect on next login)."
			else
				echo "Warning: chsh failed — your login shell is still $(getent passwd "$USER" | cut -d: -f7)."
				echo "         zsh config won't load until your login shell is zsh. Retry with: chsh -s \$(which zsh)"
			fi
		else
			echo "Warning: Your configuration won't work properly. If you exec zsh, it'll exec tmux which will exec your default shell which isn't zsh."
		fi
	fi
}

echo "We're going to do the following:"
echo "1. Check to make sure you have zsh, vim, and tmux installed"
echo "2. We'll help you install them if you don't"
echo "3. We're going to check to see if your default shell is zsh"
echo "4. We'll try to change it if it's not" 
echo "5. As a bonus you can also install pyenv to manage your python environments"

echo "Let's get started? (y/n)"
old_stty_cfg=$(stty -g)
stty raw -echo
answer=$( while ! head -c 1 | grep -i '[ny]' ;do true ;done )
stty $old_stty_cfg
if echo "$answer" | grep -iq "^y" ;then
	echo
else
	echo "Quitting, nothing was changed."
	exit 0
fi

# Check out the zsh plugin submodules (oh-my-zsh, autosuggestions, syntax-highlighting).
# Without this the shell config sources files that don't exist and startup breaks.
echo "Fetching zsh plugin submodules..."
git -C "$HOME/dotfiles" submodule update --init --recursive


check_for_software zsh
echo 
check_for_software nvim
echo
check_for_software node   # required by coc.nvim (the neovim LSP/completion layer)
echo
check_for_software tmux

# tmux copies selections to the system clipboard through wl-copy (Wayland) or xclip (X11)
if [ "$(uname)" = "Linux" ]; then
	echo
	if [ -n "$WAYLAND_DISPLAY" ]; then
		check_for_software wl-copy
	else
		check_for_software xclip
	fi
fi
echo

check_default_shell

echo
echo -n "Would you like to backup your current dotfiles? (y/n) "
old_stty_cfg=$(stty -g)
stty raw -echo
answer=$( while ! head -c 1 | grep -i '[ny]' ;do true ;done )
stty $old_stty_cfg
if echo "$answer" | grep -iq "^y" ;then
	mv ~/.zshrc ~/.zshrc.old
	mv ~/.tmux.conf ~/.tmux.conf.old
	mv ~/.vimrc ~/.vimrc.old
else
	echo -e "\nNot backing up old dotfiles."
fi

echo
echo -n "Would you also like to check for pyenv? (y/n)"
old_stty_cfg=$(stty -g)
stty raw -echo
answer=$( while ! head -c 1 | grep -i '[ny]' ;do true ;done )
stty $old_stty_cfg
if echo "$answer" | grep -iq "^y" ;then
    if [ "$(uname)" = "Darwin" ] && [ -x "$(command -v brew)" ]; then
        brew update
        brew install pyenv
        echo 'export PYENV_ROOT="$HOME/.pyenv"' >> ~/.zshrc
        echo '[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"' >> ~/.zshrc
        echo 'eval "$(pyenv init -)"' >> ~/.zshrc
        echo "Sweet, pyenv should be good to go."
    elif [ "$(uname)" = "Linux" ] && [ -x "$(command -v apt)" ]; then
        curl https://pyenv.run | bash
        echo 'export PYENV_ROOT="$HOME/.pyenv"' >> ~/.zshrc
        echo '[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"' >> ~/.zshrc
        echo 'eval "$(pyenv init -)"' >> ~/.zshrc
        echo "Sweet, pyenv should be good to go."
    else
        echo -e "\nUnable to detect environment. No changes made."
    fi
fi

echo
echo -n "Would you like to wire up the Claude Code tmux notifier? (y/n) "
old_stty_cfg=$(stty -g)
stty raw -echo
answer=$( while ! head -c 1 | grep -i '[ny]' ;do true ;done )
stty $old_stty_cfg && echo
if echo "$answer" | grep -iq "^y" ;then
    check_for_software jq
    chmod +x "$HOME/dotfiles/tmux/claude-notify.sh"
    settings="$HOME/.claude/settings.json"
    script="$HOME/dotfiles/tmux/claude-notify.sh"
    mkdir -p "$HOME/.claude"
    [ -f "$settings" ] || echo '{}' > "$settings"
    tmp=$(mktemp)
    # Idempotent: (re)set the three notifier hooks, preserve everything else.
    jq --arg s "$script" '
        .hooks.Stop = [ { "hooks": [ { "type":"command", "command": ($s + " done") } ] } ]
      | .hooks.Notification = [ { "hooks": [ { "type":"command", "command": ($s + " waiting") } ] } ]
      | .hooks.UserPromptSubmit = [ { "hooks": [ { "type":"command", "command": ($s + " generating") } ] } ]
    ' "$settings" > "$tmp" && mv "$tmp" "$settings"
    echo "Claude Code tmux notifier wired into $settings (restart Claude sessions to load)."
fi

printf "source '$HOME/dotfiles/zsh/zshrc_manager.sh'" > ~/.zshrc
printf "so $HOME/dotfiles/vim/vimrc.vim" > ~/.vimrc
printf "source-file $HOME/dotfiles/tmux/tmux.conf" > ~/.tmux.conf

echo
echo "Please log out and log back in for default shell to be initialized."

# Activate the new config in this session now, instead of requiring a re-login.
# Reads ~/.zshrc -> zshrc_manager.sh (-> exec tmux -> zsh -> zshrc.sh).
if command -v zsh >/dev/null; then
	exec zsh -l
fi
