{
    "python.analysis.diagnosticSeverityOverrides": {
        "reportIncompatibleMethodOverride": "warning",
        "reportUnusedVariable": true,
        "reportUnusedFunctionArgument": "relaxed"
    },
    "pyright": {
        "enable": true
    },
    "languageserver": {
        "clangd": {
            "command": "clangd",
            "args": [
                "--background-index",
                "--clang-tidy",
                "--header-insertion=iwyu",
                "--completion-style=detailed",
                "--function-arg-placeholders"
            ],
            "filetypes": ["c", "cc", "cpp", "c++", "objc", "objcpp"],
            "rootPatterns": ["compile_commands.json", ".clangd", ".git/", ".hg/"],
            "initializationOptions": {
                "fallbackFlags": ["-std=c++20"]
            }
        },
        "go": {
            "command": "gopls",
            "rootPatterns": ["go.mod"],
            "trace.server": "verbose",
            "filetypes": ["go"]
        },
        "csharp-ls": {
            "command": "csharp-ls",
            "filetypes": ["cs"],
            "rootPatterns": ["*.csproj", ".vim/", ".git/", ".hg/"],
            "initializationOptions": {
                "hostInfo": "neovim"
            }
        },
        "rust_analyzer": {
            "command": "rust-analyzer",
            "filetypes": ["rust"],
            "rootPatterns": ["Cargo.toml", "rust-project.json"],
            "trace.server": "verbose",
            "settings": {
                "rust-analyzer": {}
            }
        },
        "zig": {
            "enabled": true,
            "startUpMessage": true,
            "path": "zls",
            "debugLog": false
        },
        "gdscript": {
            "command": "/Applications/Godot 2.app/Contents/MacOS/Godot",
            "args": ["--headless", "--editor", "--lsp"],
            "filetypes": ["gdscript"],
            "rootPatterns": ["project.godot"],
            "trace.server": "verbose"
        }
    }
}
